# DirectiveBench reads no secrets from environment files in the bootstrap release.
# All variables below are optional.

# Override the data directory (SQLite database, config, fixture snapshots, logs).
# Default: OS-specific application data directory (see .ai/specs/2026-10-14-local-installation.md).
# DIRECTIVEBENCH_DATA_DIR=./.directivebench

# Host and port of the local web server. The default host is loopback-only.
# Binding to a non-loopback address additionally requires `--allow-network-access`.
# DIRECTIVEBENCH_HOST=127.0.0.1
# DIRECTIVEBENCH_PORT=4280
