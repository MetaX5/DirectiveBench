{
  "name": "@directivebench/web",
  "version": "0.1.0",
  "private": true,
  "description": "DirectiveBench local web UI (Next.js App Router). Reads SQLite through @directivebench/database and enqueues jobs; never executes benchmarks itself.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test-storybook": "vitest run --config vitest.storybook.config.ts"
  },
  "dependencies": {
    "@directivebench/agent-adapters": "workspace:*",
    "@directivebench/benchmark-engine": "workspace:*",
    "@directivebench/core": "workspace:*",
    "@directivebench/database": "workspace:*",
    "@fontsource-variable/figtree": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.22.1",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "8.3.4"
  }
}
